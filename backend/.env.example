# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Gmail SMTP (use an App Password, NOT your regular Gmail password)
SMTP_EMAIL=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_DISPLAY_NAME=Teacher Name

APP_BASE_URL=https://yourapp.onrender.com
ADMIN_KEY=your-admin-key-here
# Set this same value on BOTH Render (backend) and Vercel (serverless proxy)
CORS_ORIGINS=https://unwanted-mu.vercel.app
DB_PATH=./data/tracker.db
