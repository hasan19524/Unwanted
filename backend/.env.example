# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Brevo email (free tier: 300 emails/day, no credit card)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender@gmail.com
BREVO_SENDER_NAME=Teacher Name

# Neon PostgreSQL (free tier, data persists)
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

APP_BASE_URL=https://yourapp.onrender.com
CORS_ORIGINS=https://unwanted-mu.vercel.app

# No auth env vars needed - users sign up and log in with email + password
