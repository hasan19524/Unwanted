# Dedicated Gmail account for sending (create this once, set 2FA + app password)
SMTP_EMAIL=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_DISPLAY_NAME=Teacher Name

# App settings
APP_BASE_URL=http://localhost:8000
ADMIN_KEY=change-this-to-a-random-string

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database path (SQLite, relative to backend dir)
DB_PATH=./data/tracker.db
